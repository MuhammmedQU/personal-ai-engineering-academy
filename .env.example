# ============================================================================
# AI Engineering Academy — Environment Configuration (.env.example)
# ============================================================================
# Copy this file to `.env` if you want to connect a live LLM provider for the
# AI Mentor. The application works completely offline in Demo Mentor Mode
# without any API key.
#
# SECURITY: These variables are read ONLY by the local Node backend server and
# are NEVER sent to the browser.

# Provider type: "demo" (default offline mode) | "openai" | "gemini" | "anthropic" | "ollama"
AI_PROVIDER=demo

# API Key for your chosen provider (never exposed client-side)
AI_API_KEY=
# You can also set provider-specific keys:
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model name (optional; sensible default used per provider)
# Examples:
#   openai:    gpt-4o-mini
#   gemini:    gemini-2.5-flash
#   anthropic: claude-3-5-sonnet-latest
#   ollama:    llama3.1
AI_MODEL=

# Custom base URL (optional; useful for Ollama http://localhost:11434/v1 or OpenRouter)
AI_BASE_URL=

# Server port and SQLite database path (optional)
PORT=3001
DB_PATH=./data/academy.sqlite
